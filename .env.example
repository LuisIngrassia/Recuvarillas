# Copiar a `.env` y completar con los datos del proyecto de Supabase.
# Están en el panel: Project Settings → API.
#
# La clave `anon` es pública: viaja en el bundle de la web y no es un secreto.
# Lo que cuida los datos son las políticas de `supabase/schema.sql`.
# La `service_role` NO va acá ni en ningún archivo del front.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
